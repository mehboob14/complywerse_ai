[
  {
    "rule_id": "3.1.3",
    "title": "Ensure the logging collector is enabled",
    "check_definition": {
      "runner": "postgres_sql",
      "sql": "SELECT setting FROM pg_settings WHERE name = 'logging_collector'",
      "expect": {
        "kind": "first_value_equals",
        "expected": "on"
      },
      "pass_message": "Logging collector is enabled.",
      "fail_message": "Logging collector is OFF \u2014 server logs are not captured.",
      "_authored": "cis-pg18-config",
      "timeout_seconds": 15
    }
  },
