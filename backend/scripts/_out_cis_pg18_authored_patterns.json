    "rule_id": "3.2",
    "title": "Ensure the PostgreSQL Audit Extension (pgAudit) is enabled",
    "check_definition": {
      "runner": "postgres_sql",
      "sql": "SELECT setting FROM pg_settings WHERE name='shared_preload_libraries'",
      "expect": {
        "kind": "first_value_contains",
