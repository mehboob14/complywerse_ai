  {
    "rule_id": "4.8",
    "title": "Ensure the set_user extension is installed",
    "check_definition": {
      "runner": "postgres_sql",
      "sql": "SELECT count(*) FROM pg_extension WHERE extname='set_user'",
      "expect": {
        "kind": "row_count_nonzero"
      },
      "pass_message": "set_user extension is installed.",
      "fail_message": "set_user extension is NOT installed.",
      "_authored": "cis-pg18-config"
    }
  },
  {
    "rule_id": "5.2",
    "title": "Ensure PostgreSQL is Bound to an IP Address",
    "check_definition": {
      "runner": "postgres_sql",
      "sql": "SELECT setting FROM pg_settings WHERE name = 'listen_addresses'",
      "expect": {
        "kind": "first_value_regex",
        "expected": "^(?!\\*).+"
      },
      "pass_message": "listen_addresses is bound to specific host(s), not '*'.",
      "fail_message": "listen_addresses is '*' \u2014 the DB accepts connections on every interface.",
      "_authored": "cis-pg18-config",
      "timeout_seconds": 15
    }
  },
  {
    "rule_id": "6.8",
