# =============================================================================
# GRC-Tenant — Backend environment template
# =============================================================================
# Copy to `.env` for local dev, or to `/etc/grc/backend.env` (mode 0640,
# owner root:grc) when deploying to Ubuntu via systemd. Production values
# should never be committed; this file only documents the variable names
# and shape so a fresh deployment knows exactly what to set.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — multi-tenant per-DB Postgres
# -----------------------------------------------------------------------------
# The catalog DB stores the tenants registry. Every tenant gets its own
# database named `grc_<slug>`; the template below is interpolated at
# runtime via `.format(slug=...)`.
#
# The app role MUST have CREATEDB privilege because `tenant_manager.py`
# issues `CREATE DATABASE grc_<slug>` on each new-tenant signup.
MASTER_DATABASE_URL=postgresql://<db-user>:<db-password>@127.0.0.1:5432/grc_master
TENANT_DB_URL_TEMPLATE=postgresql://<db-user>:<db-password>@127.0.0.1:5432/grc_{slug}
POSTGRES_ADMIN_URL=postgresql://<db-user>:<db-password>@127.0.0.1:5432/postgres

# -----------------------------------------------------------------------------
# Redis — cache, locks, Celery broker + result backend
# -----------------------------------------------------------------------------
# Three logical DBs on a single Redis instance. If you run Redis with
# `requirepass`, embed the password in the URL: `redis://:PASS@host:port/N`.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Per-tenant rate limit applied to background jobs (locks live in REDIS_URL)
TENANT_JOB_RATE_PER_MIN=120

# -----------------------------------------------------------------------------
# Auth / cookies
# -----------------------------------------------------------------------------
# JWT signing key. Generate with: openssl rand -hex 48
SESSION_SECRET=<generate-with-openssl-rand-hex-48>

# Cookie domain. Use a leading dot for cross-subdomain auth in prod, e.g.
# `.compliverse.ai` so `acme.compliverse.ai` and `beta.compliverse.ai`
# share the session. Leave empty in dev to default to `.localhost`.
AUTH_COOKIE_DOMAIN=

# Set to "1" in production so cookies are flagged Secure (HTTPS-only).
REPL_DEPLOYMENT=0

# -----------------------------------------------------------------------------
# CORS — set ONE of these in production. Both omitted => localhost-only.
# -----------------------------------------------------------------------------
# Regex matching every allowed origin. Use this for wildcard subdomains:
#   ALLOWED_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?compliverse\.ai$
ALLOWED_ORIGIN_REGEX=

# Comma-separated explicit list. Use when regex is overkill:
#   ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Alias used by the integrations module — keep in sync with OPENAI_API_KEY
AI_INTEGRATIONS_OPENAI_API_KEY=
# Optional: route through a different OpenAI-compatible base (Azure, ModelFarm)
AI_INTEGRATIONS_OPENAI_BASE_URL=
# Tenant-local AI token analytics. Disable for an emergency telemetry rollback.
AI_USAGE_ANALYTICS_ENABLED=true
# Optional versioned price catalog. When empty, tokens are tracked and cost is
# shown as unconfigured instead of applying an unverifiable price.
# AI_USAGE_PRICE_CATALOG_JSON={"version":"YYYY-MM-DD","models":{"gpt-4o-mini":{"input_per_million":0,"cached_input_per_million":0,"output_per_million":0}}}
AI_USAGE_PRICE_CATALOG_JSON=

# -----------------------------------------------------------------------------
# Vector DB (Qdrant) — used by ComplyChat for retrieval-augmented chat
# -----------------------------------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# SMTP — outbound email notifications
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# -----------------------------------------------------------------------------
# n8n — workflow automation engine
# -----------------------------------------------------------------------------
# Internal API base. The webhook base may differ if n8n sits behind a
# different reverse-proxy hostname (e.g. when receiving callbacks from a
# third-party service).
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_BASE=http://localhost:5678
N8N_INTERNAL_SECRET=CHANGE_ME
n8n_api_key=

# -----------------------------------------------------------------------------
# Embedded background workers — toggle off when extracting to dedicated hosts
# -----------------------------------------------------------------------------
# Workflow runtime polls the platform_events table every 0.5s in a daemon
# thread. Set to 1 when running a dedicated `grc-workflow.service` so the
# API process doesn't double-poll.
DISABLE_EMBEDDED_WORKFLOW_RUNTIME=0

# ComplyChat embedding worker syncs document chunks to Qdrant. Set to 1
# unless you actively use ComplyChat — embedding work is expensive and
# noisy in the API process.
DISABLE_COMPLYCHAT_EMBED_WORKER=1
COMPLYCHAT_EMBED_WORKER_AUTOSTART=true
COMPLYCHAT_EMBED_WORKER_INTERVAL_SECONDS=120

# -----------------------------------------------------------------------------
# Filesystem — uploaded files (evidence, frameworks, reports, …)
# -----------------------------------------------------------------------------
# In production, deploy with a symlink:
#   /opt/grc/app/backend/uploads -> /var/lib/grc/uploads
# so the relative paths the code uses always land on persistent storage.
# This variable is informational only; the code uses relative paths.
UPLOAD_ROOT=/var/lib/grc/uploads

# -----------------------------------------------------------------------------
# Agent installer URL (CIS Compliance Agent download endpoints)
# -----------------------------------------------------------------------------
# Public URL the agent installer phones home to. Baked into the
# .bat / .ps1 / .sh installer scripts served from /grc/agent/install.*
# and /grc/agents/installer.cmd.
#
# MUST be set in production. Without it the helper falls back to
# X-Forwarded-Host (proxy) or the request's Host header — both can be
# wrong behind dev / staging proxies.
#
# Examples:
#   https://grc.bank.com           (cloud, public TLS)
#   https://10.0.0.5:4000          (LAN-only, with TLS)
#   http://127.0.0.1:4000          (single-machine same-host dev)
COMPLYVERSE_BACKEND_URL=

# Override the on-disk paths to pre-built agent artifacts. Defaults
# point at backend/agent/packaging/{windows,linux}/. Set to your CI
# artifact path or a shared NFS mount when shipping signed binaries.
# COMPLYVERSE_AGENT_EXE_PATH=/var/lib/grc/agent/ComplyverseAgent-Setup-1.0.0.exe
# COMPLYVERSE_AGENT_DEB_PATH=/var/lib/grc/agent/complyverse-agent_1.0.0_all.deb
# COMPLYVERSE_AGENT_GPO_PATH=/var/lib/grc/agent/Deploy-ComplyverseAgent.ps1

# -----------------------------------------------------------------------------
# Compliance plugin library — canonical source tenant
# -----------------------------------------------------------------------------
# When a new tenant is provisioned, the platform automatically copies
# the ~5,300 PDF-ingested CIS benchmark rules (Win 11, Ubuntu, etc.)
# from the named source tenant. Without this, new tenants land with
# only the 36 built-in PLUGIN_LIBRARY rules and the /library page
# looks empty.
#
# Defaults to 'company'. On fresh installs before you've ingested
# any CIS PDFs, leave it as-is — sync becomes a silent no-op until
# you've seeded a source.
CANONICAL_LIBRARY_SOURCE_SLUG=company

# -----------------------------------------------------------------------------
# Subdomain-based tenant resolution
# -----------------------------------------------------------------------------
# In production the platform extracts the tenant slug from the
# Host header subdomain (e.g. acme.bank.com -> slug 'acme'). Set
# AUTH_COOKIE_DOMAIN to your TLD so the JWT cookie works across
# subdomains:  AUTH_COOKIE_DOMAIN=.bank.com
#
# DEFAULT_TENANT_SLUG is a single-tenant / IP-only-deployment fallback.
# When set, ALL unresolved requests route to this tenant. UNSET in
# multi-tenant production — keeping it set silently routes wrong-
# subdomain requests into this tenant.
DEFAULT_TENANT_SLUG=

# -----------------------------------------------------------------------------
# Tesseract OCR (optional — DCC / Saudi NCA PDF parsing)
# -----------------------------------------------------------------------------
# Path to the tesseract binary. On Ubuntu:
#   apt install tesseract-ocr -y
#   TESSERACT_CMD=/usr/bin/tesseract
# Leave unset to disable OCR (compliance assessments degrade gracefully).
TESSERACT_CMD=

# -----------------------------------------------------------------------------
# CORS / cookies for cross-origin frontend
# -----------------------------------------------------------------------------
# Pick ONE of these; both empty = localhost-only.
# ALLOWED_ORIGINS=https://grc.bank.com,https://admin.bank.com
# ALLOWED_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?bank\.com$

# Set REPL_DEPLOYMENT=1 in production to force Secure (HTTPS-only)
# cookies. Unset / 0 in dev.
# REPL_DEPLOYMENT=1
