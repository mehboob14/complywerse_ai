{
  "id": "hitrust_csf",
  "name": "HITRUST Common Security Framework (CSF)",
  "version": "11.4.0",
  "official_sources": [
    {
      "title": "HITRUST CSF v11 - Overview",
      "url": "https://hitrustalliance.net/product-tool/hitrust-csf/"
    },
    {
      "title": "HITRUST Risk Management Methodology (MyCSF / r2 / i1 / e1)",
      "url": "https://hitrustalliance.net/risk-management-framework"
    },
    {
      "title": "HITRUST Assurance Program Requirements",
      "url": "https://hitrustalliance.net/assurance-program/"
    },
    {
      "title": "HITRUST PRISMA-derived Maturity Model",
      "url": "https://hitrustalliance.net/maturity-model"
    }
  ],
  "assessment_shapes": [
    "control_maturity"
  ],
  "methodology": "HITRUST CSF assesses each control across the five PRISMA-derived maturity levels — Policy, Procedure, Implemented, Measured, Managed — producing a weighted control score (0-100). The framework supports the e1 (essentials), i1 (implemented) and r2 (risk-based, two-year) assessment scopes. Assessors record the implementation status and maturity level for each in-scope HITRUST CSF control across the 14 control categories (00-13), then aggregate to control reference, requirement statement and authoritative-source level. Residual risks are accepted, treated or transferred per the organisation's risk treatment plan and reported in the HITRUST assessment object.",
  "scoping_inputs": [
    {
      "id": "assessment_type",
      "type": "select",
      "options": [
        "e1 - Essentials, 1-year",
        "i1 - Implemented, 1-year",
        "r2 - Risk-based, 2-year",
        "Bridge",
        "Readiness / Self"
      ],
      "label": "HITRUST assessment type"
    },
    {
      "id": "risk_factors",
      "type": "multi_select",
      "options": [
        "Geographic (US States)",
        "Regulatory (HIPAA, HITECH, GDPR, PCI, FedRAMP, CMMC)",
        "Organizational size",
        "Volume of records",
        "Type of information processed (PHI, PII, financial)",
        "External connections",
        "Mobile device usage",
        "Cloud / SaaS hosting"
      ],
      "label": "Inheritance / risk factors driving control selection"
    },
    {
      "id": "ehealth_inscope",
      "type": "list",
      "label": "EHR / e-health systems in scope"
    },
    {
      "id": "phi_volume",
      "type": "select",
      "options": [
        "< 60,000 records",
        "60,000 - 1.5M records",
        "> 1.5M records"
      ],
      "label": "PHI volume (drives HITRUST organisational risk factor)"
    },
    {
      "id": "regulatory_overlays",
      "type": "multi_select",
      "options": [
        "HIPAA Security Rule",
        "HIPAA Privacy Rule",
        "HITECH Act",
        "EU GDPR",
        "PCI DSS",
        "NIST 800-53",
        "NIST CSF",
        "ISO 27001",
        "FedRAMP",
        "CMMC",
        "State privacy laws (TX, CA, NY)"
      ],
      "label": "Authoritative-source overlays included"
    }
  ],
  "risk_model": {
    "factors": [
      "asset",
      "threat",
      "vulnerability",
      "likelihood",
      "impact_c",
      "impact_i",
      "impact_a",
      "impact_compliance"
    ],
    "scales": {
      "likelihood": [
        { "value": 1, "label": "Rare",           "definition": "Highly unlikely in this PHI-handling environment (<5%)." },
        { "value": 2, "label": "Unlikely",       "definition": "Possible but not expected (5-25%)." },
        { "value": 3, "label": "Possible",       "definition": "May occur in normal operations (25-50%)." },
        { "value": 4, "label": "Likely",         "definition": "Probable in normal operations (50-75%)." },
        { "value": 5, "label": "Almost Certain", "definition": "Expected to occur (>75%)." }
      ],
      "impact": [
        { "value": 1, "label": "Insignificant", "definition": "Negligible operational or regulatory impact." },
        { "value": 2, "label": "Minor",         "definition": "Limited PHI exposure or service degradation; minor breach-notification effort." },
        { "value": 3, "label": "Moderate",      "definition": "Notable PHI / PII exposure or material service disruption; regulator notification required." },
        { "value": 4, "label": "Major",         "definition": "Large-scale breach (>500 records under HIPAA); HHS OCR notification; OCR audit risk." },
        { "value": 5, "label": "Severe",        "definition": "Mass breach / patient safety impact; criminal exposure, regulatory enforcement, loss of HITRUST certification." }
      ],
      "maturity": [
        { "value": 0,   "label": "Non-compliant",  "definition": "Element is not present (0% credit)." },
        { "value": 25,  "label": "Somewhat compliant", "definition": "Element is partially present (~25% credit)." },
        { "value": 50,  "label": "Partially compliant", "definition": "Element is half-implemented (~50% credit)." },
        { "value": 75,  "label": "Mostly compliant",  "definition": "Element is largely in place with minor gaps (~75% credit)." },
        { "value": 100, "label": "Fully compliant",   "definition": "Element fully meets the HITRUST CSF requirement (100% credit)." }
      ],
      "implementation_status": [
        { "value": "NI", "label": "Not Implemented" },
        { "value": "PI", "label": "Partially Implemented" },
        { "value": "LI", "label": "Largely Implemented" },
        { "value": "FI", "label": "Fully Implemented" },
        { "value": "NA", "label": "Not Applicable (justify in CCSF)" }
      ]
    },
    "matrix": "5x5",
    "calculation": "likelihood * max(impact_c, impact_i, impact_a, impact_compliance)",
    "acceptance_threshold": 6,
    "thresholds": {
      "low":      [1, 4],
      "medium":   [5, 9],
      "high":     [10, 16],
      "critical": [17, 25]
    }
  },
  "domains": [
    {
      "id": "CAT_00_ISMP",
      "name": "0 — Information Security Management Program",
      "controls": [
        {
          "id": "00.a",
          "title": "Information Security Management Program",
          "description": "Establish, document, implement, maintain and continually improve a formal information security management program.",
          "question_block": {
            "type": "control_maturity",
            "questions": [
              { "field": "policy_maturity", "type": "scale", "scale": "maturity", "prompt": "Policy maturity (0/25/50/75/100): is there a documented, approved ISMS policy covering this control?" },
              { "field": "procedure_maturity", "type": "scale", "scale": "maturity", "prompt": "Procedure maturity: are documented procedures in place to execute the policy?" },
              { "field": "implemented_maturity", "type": "scale", "scale": "maturity", "prompt": "Implemented maturity: are the procedures actually executed in operations?" },
              { "field": "measured_maturity", "type": "scale", "scale": "maturity", "prompt": "Measured maturity: are control effectiveness metrics collected and reviewed?" },
              { "field": "managed_maturity", "type": "scale", "scale": "maturity", "prompt": "Managed maturity: are deficiencies driven to closure via corrective action?" },
              { "field": "evidence", "type": "text", "prompt": "Evidence (policy doc, sample procedure, ticket log, KRI dashboard, CAP register)." },
              { "field": "implementation_status", "type": "select", "scale": "implementation_status", "prompt": "Overall implementation status?" },
              { "field": "owner", "type": "text", "prompt": "Control owner." },
              { "field": "target_date", "type": "date", "prompt": "Target remediation date for any deficiency." }
            ]
          }
        }
      ]
    },
