  "documents": [
    {
      "type": "gdpr__gdpr_consent_form_template_1",
      "label": "Consent Form",
      "control_ref": null,
      "sections": [
        {
          "heading": "1. Purpose",
          "body": "These forms capture and withdraw consent in a way that is freely given, specific, informed and unambiguous, and they make withdrawal as easy as giving consent. Keep a record of each consent: who consented, to what, when and the wording they saw."
        },
        {
          "heading": "2. Scope",
          "body": "Use wherever consent is the lawful basis for processing."
        },
        {
          "heading": "3. Form 1: Consent",
          "body": "I, ____________________, consent to [Company Name] processing my personal data for the following specific purpose(s): ____________________.\nI understand what data is collected, that I can withdraw consent at any time, and how to do so.\nSignature: ____________  Date: ______"
        },
        {
          "heading": "4. Form 2: Withdrawal of Consent",
          "body": "I, ____________________, withdraw my consent for [purpose] given on [date]. I understand that withdrawal does not affect the lawfulness of processing carried out before I withdrew.\nSignature: ____________  Date: ______"
        },
        {
          "heading": "5. Form 3: Parental or Guardian Consent (children)",
          "body": "I, ____________________, parent or guardian of ____________________ (child), consent to [Company Name] processing the child's data for [purpose].\nSignature: ____________  Date: ______"
        },
        {
          "heading": "6. Record of Consent",
          "body": "For each consent, record who consented, to what, when, how it was obtained and the exact wording the person was shown."
        }
      ]
    }
  ]
