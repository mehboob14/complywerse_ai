# GRC Frontend environment variables
#
# In development (Replit): /api routes through the Replit path-based proxy
# to the Express API server artifact (preview path: /api), which proxies
# all requests to the Python FastAPI backend at http://127.0.0.1:5000/grc/*
#
# Leave unset or set to /api for Replit development.
# Set to a full URL (e.g. http://localhost:8080/api) for local development
# outside of Replit.
VITE_API_BASE_URL=/api
