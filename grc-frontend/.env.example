# =============================================================================
# GRC-Tenant — Frontend (Next.js 14) environment template
# =============================================================================
# Copy to `.env.local` for local dev, or to `/etc/grc/frontend.env` (mode
# 0640, owner root:grc) when deploying via systemd. The Next.js process
# only reads what's set here at start time, so restart the unit after
# changes:  systemctl restart grc-frontend
# =============================================================================

# Standard Next.js runtime knobs
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# -----------------------------------------------------------------------------
# Backend wiring
# -----------------------------------------------------------------------------
# next.config.js rewrites every browser request to `/api/*` over to
# `${BACKEND_URL}/grc/*` server-side. The browser therefore only ever
# talks to its own origin — Next.js does the proxy. Set BACKEND_URL to
# wherever the FastAPI app listens (loopback in single-host deploys, or
# the internal host:port if the API moves to a separate machine).
BACKEND_URL=http://127.0.0.1:4000

# Public-facing URL of the platform — used by client-side code that needs
# to know the canonical domain (e.g. cross-subdomain redirect targets).
NEXT_PUBLIC_BACKEND_URL=https://app.example.com

# Axios baseURL for client-side calls. Leave as `/api` so the browser
# stays on its own origin and Next.js's rewrite handles the proxy.
NEXT_PUBLIC_API_BASE_URL=/api
