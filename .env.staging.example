# =============================================================================
# Staging stack — environment template.
# Copy to `.env.staging` on the droplet and fill in real values. The compose
# file references this via `--env-file .env.staging`.
# =============================================================================

# ---- Public port on the host ----
# Only frontend is exposed; everything else stays on the internal network.
# Change if 8080 is already taken on the droplet.
PUBLIC_PORT=8080

# ---- The droplet's public IP (used for the browser-facing URL) ----
# Browser hits http://<DROPLET_IP>:<PUBLIC_PORT> and never talks to backend
# directly; Next.js proxies /api/* server-side via BACKEND_URL.
DROPLET_IP=203.0.113.10
NEXT_PUBLIC_BACKEND_URL=http://203.0.113.10:8080

# ---- Postgres (Dockerized, isolated from prod) ----
POSTGRES_USER=grc_stg
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_AT_LEAST_24_CHARS
POSTGRES_DB=grc_master

# ---- Auth / cookies ----
# Generate with: openssl rand -hex 48
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_STRING

# ---- CORS ----
# Matches http(s)://<droplet-ip>:<any-port> — fine for an IP-only staging.
# Tighten to your specific IP+port pair if you prefer.
ALLOWED_ORIGIN_REGEX=^https?://[0-9.]+(:[0-9]+)?$

# ---- AI / LLM (optional but required for AI-assist features) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
