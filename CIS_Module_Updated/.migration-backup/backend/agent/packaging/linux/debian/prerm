#!/bin/sh
# Pre-remove: stop service, leave vault on disk so an upgrade
# (which calls prerm THEN postinst) keeps the user's enrolment.
# Only `postrm purge` wipes state.
set -e

if systemctl is-active --quiet complyverse-agent; then
    systemctl stop complyverse-agent || true
fi
if systemctl is-enabled --quiet complyverse-agent 2>/dev/null; then
    systemctl disable complyverse-agent || true
fi

exit 0
