#!/bin/sh
# Debian post-install: create system user, set up state dirs, enable timer.
# Idempotent — safe to run on package upgrade.
set -e

# 1. Create dedicated system user if not already present
if ! getent passwd complyverse >/dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin \
            --comment "Compliverse Agent" complyverse
fi

# 2. Create state + log directories owned by that user
install -d -o complyverse -g complyverse -m 0750 /var/lib/complyverse-agent
install -d -o complyverse -g complyverse -m 0750 /var/log/complyverse-agent

# 3. Reload systemd so it sees the new unit file
systemctl daemon-reload || true

# 4. Tell the operator next steps. We do NOT auto-start — the agent has
#    no enrollment token yet, so starting now would just spam errors.
cat <<EOF

================================================================
Compliverse Compliance Agent installed.

Next steps:
  1. Enroll with your cloud tenant:
     sudo -u complyverse /opt/complyverse-agent/bin/complyverse-agent \\
          enroll --backend https://your-tenant.compliverse.app \\
                 --token <enrollment-token>

  2. Enable + start the service:
     sudo systemctl enable --now complyverse-agent

  3. Check status:
     systemctl status complyverse-agent
     journalctl -u complyverse-agent -f

For collector mode (scanning remote network devices), add credentials:
     sudo -u complyverse /opt/complyverse-agent/bin/complyverse-agent \\
          cred set --asset-id 42 --type netdev_ssh \\
                   --host 10.0.0.5 --port 22 --username svc-compliverse
================================================================
EOF

exit 0
